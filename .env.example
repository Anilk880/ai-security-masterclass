# Copy this file to .env and fill in your own key. Never commit the real .env.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-own-key-here

# Optional: override the default model used by the code examples.
OPENAI_MODEL=gpt-4o-mini

# No OpenAI account? Set this to "dummy" and every code example in this
# course runs fully offline, no key or network needed, with clearly-labeled
# static replies -- you can still read and run every example. Leaving
# OPENAI_API_KEY unset above does this automatically even without setting
# this explicitly. Set to "openai" (with a real key above) for real model
# calls.
LLM_BACKEND=openai
